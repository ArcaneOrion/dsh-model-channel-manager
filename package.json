{
  "name": "@arcaneorion/dsh-model-channel-manager",
  "version": "0.4.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test": "node --expose-internals --test \"tests/*.test.cjs\"",
    "test:framework": "node --test tests/framework/volatile-rollback.cjs",
    "test:browser": "node scripts/test-browser.cjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "description": "DSH model channel manager: roundrobin failover engine (host) + model config view tab (client).",
  "license": "MIT",
  "author": "arcanexis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaneOrion/dsh-model-channel-manager.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "llm",
    "roundrobin",
    "failover",
    "model"
  ],
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "yaml": "^2.9.0",
    "acorn": "^8.18.0",
    "esbuild": "^0.28.1",
    "react-dom": "^18.3.1",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.1",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.1",
    "@deepseek-ai/dsh-hmr": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4",
    "react": "^18.3.1",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  }
}
